# ─────────────────────────────────────────────────────────────────────────
# Arlo — environment. Copy to `.env` and fill in. NEVER commit your real .env.
# ─────────────────────────────────────────────────────────────────────────

# Core (required) ----------------------------------------------------------
# PostgreSQL connection string.
DATABASE_URL="postgresql://arlo_app:CHANGE_ME@127.0.0.1:5432/arlo?schema=public"
# 64 hex chars (32 bytes) — AES-256-GCM key for encrypting stored integration
# secrets. Generate with:  openssl rand -hex 32
APP_ENCRYPTION_KEY="REPLACE_WITH_64_HEX_CHARS"
# >=32 chars — signs owner session cookies. Generate with:  openssl rand -hex 32
SESSION_SECRET="REPLACE_WITH_A_LONG_RANDOM_STRING"

# Infrastructure (optional; sensible defaults) -----------------------------
REDIS_URL="redis://127.0.0.1:6379/4"
BULLMQ_PREFIX="arlo"
APP_URL="https://arlo.example.com"   # public base URL (used for webhooks)
TZ="Asia/Karachi"
PORT=3430
HOSTNAME=127.0.0.1

# ─────────────────────────────────────────────────────────────────────────
# Provider keys (OPTIONAL). You can set them here OR in the app's Settings UI
# (stored AES-256-GCM encrypted). If set here, these OVERRIDE the stored value.
# Leave blank to manage everything from Settings.
# ─────────────────────────────────────────────────────────────────────────

# Reasoning models
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
# OPENAI_BASE_URL=""
# ANTHROPIC_BASE_URL=""

# Lead discovery (Serper.dev or Google Places)
SEARCH_API_KEY=""

# Email verification (ZeroBounce / NeverBounce / Email Awesome)
VERIFIER_API_KEY=""
# Shared secret the Email Awesome results webhook must present. Auto-generated
# and stored encrypted if omitted. openssl rand -hex 24
VERIFIER_WEBHOOK_SECRET=""

# Voice — speech-to-text (OpenAI Whisper / Deepgram) and text-to-speech
# (OpenAI / ElevenLabs). Kept separate from the reasoning model.
STT_API_KEY=""
TTS_API_KEY=""

# ─────────────────────────────────────────────────────────────────────────
# Website rendering (OPTIONAL) — how Arlo reads prospect sites & your brand.
# ─────────────────────────────────────────────────────────────────────────
# Built-in JavaScript rendering uses a headless Chromium already on the host
# (via puppeteer-core — no bundled download). It's ON by default when a browser
# is found. Install one with:  apt-get install -y chromium   (or chromium-browser)
# RENDER_JS="false"              # set to "false" to disable built-in rendering
# CHROMIUM_PATH="/usr/bin/chromium"   # only if your browser is in a custom path
#
# Firecrawl is an OPTIONAL alternative to the built-in renderer (not required).
# Set either a hosted key OR a self-hosted base URL to use it instead.
# FIRECRAWL_API_KEY=""
# FIRECRAWL_BASE_URL=""          # e.g. http://127.0.0.1:3002 for self-hosted
